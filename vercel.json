{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "double-sound.vercel.app" }],
      "destination": "https://doublesound.live/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
